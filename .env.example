# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.

# --- FRED (St. Louis Fed) ---
# Đăng ký key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- dulieukinhte.com (số liệu Việt Nam: tín dụng, M2, CPI, ...) ---
# Đăng ký key miễn phí: https://console.dulieukinhte.com/dang-ky (100 lượt/tháng, 5 năm lịch sử)
# Gắn chuỗi cần kéo trong config/dulieukinhte.yaml
DLKT_API_KEY=

# --- Yahoo Finance ---
# Không cần key (yfinance). Nghỉ giữa các ticker để tránh bị rate-limit (giây).
YF_SLEEP_SECONDS=1.0

# --- Phạm vi kéo dữ liệu ---
# Ngày bắt đầu khi kéo lần đầu (YYYY-MM-DD). Các lần sau chỉ kéo tăng thêm.
FETCH_START=2010-01-01
# Thư mục ghi output của crawler (tương đối với gốc repo).
EXTERNAL_DATA_DIR=data/external

# --- Mạng công ty (tùy chọn) ---
# Bỏ comment nếu phải đi qua proxy. Không ghi user/password vào đây nếu proxy có xác thực dùng chung.
# HTTPS_PROXY=http://proxy.company.local:8080
# HTTP_PROXY=http://proxy.company.local:8080

# --- App ---
# Chạy local: APP_MODE=admin. Để trống ADMIN_PASSWORD thì vào thẳng chế độ quản trị;
# đặt mật khẩu thì phải đăng nhập. Bản deploy công khai: để trống APP_MODE (chỉ xem).
ADMIN_PASSWORD=
APP_MODE=admin
REPO_URL=

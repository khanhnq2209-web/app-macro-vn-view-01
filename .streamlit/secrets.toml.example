# Copy thành .streamlit/secrets.toml (đã gitignore) hoặc đặt biến môi trường cùng tên.
ADMIN_PASSWORD = "doi-mat-khau-nay"
APP_MODE = "admin"    # chạy local. Bản deploy công khai: bỏ dòng này (mặc định chỉ xem, ẩn số Yahoo)
# REPO_URL = "https://github.com/<org>/<repo>"
# Bản deploy: hiện số Yahoo (DXY...) và LME (đồng). Chỉ bật khi app chia sẻ nội bộ (mời email);
# người bật chịu trách nhiệm về điều khoản dữ liệu của Yahoo và Westmetall/LME.
# SHOW_VENDOR_DATA = "1"

# ============ Lưu cấu hình scorecard online (Google Sheets) ============
# Chỉ điền giá trị thật vào .streamlit/secrets.toml (đã gitignore) hoặc ô Secrets của Streamlit Cloud.
# KHÔNG commit khóa thật. Hướng dẫn lấy khóa: docs/proposal_scorecard_v3.md mục 8.

# Mật khẩu để sửa cấu hình scorecard trên app (người dùng bấm Cấu hình, nhập mật khẩu là sửa và lưu được).
CONFIG_PASSWORD = "doi-mat-khau-nay"

[gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/<ID_SHEET>/edit"   # Sheet có tab "versions"
# Các dòng dưới lấy từ file JSON của service account (không dán cả file):
type = "service_account"
project_id = "<project_id>"
private_key_id = "<private_key_id>"
private_key = "<dán nguyên giá trị private_key trong file JSON, giữ các ký tự \n>"
client_email = "<ten>@<project>.iam.gserviceaccount.com"   # chia sẻ Sheet cho địa chỉ này (Editor)
client_id = "<client_id>"
token_uri = "https://oauth2.googleapis.com/token"
